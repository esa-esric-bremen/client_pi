         in the Python package index (https://packaging.python.org/tutorials/distributing-packages/#classifiers)
         but we don't have a predefined list of allowed classifiers. -->
    <classifier>utilities</classifier>
    <classifier>robot-remote-control</classifier><!-- your (robotics) framework -->
    <classifier>C++</classifier><!-- your programming language -->
    <classifier>Development Status :: 3 - Alpha</classifier>
  </classifiers>

